# SQL Server (Axapta) — alleen lezen
# Servernaam of IP, bijv. AXAPTA of 192.168.5.34
AX_SQL_SERVER=192.168.5.34
AX_SQL_DATABASE=AXDB30SP4
AX_DATAAREAID=fmd

# SQL-login met alleen SELECT (aanbevolen; werkt ook vanaf een andere pc)
AX_SQL_GEBRUIKER=fmid_pickkoppel
AX_SQL_WACHTWOORD=

# Firebase service-account (pad naar het json-bestand op deze pc)
# Linux:  /opt/fmid-koppeling/firebase-sleutel.json
# Windows: C:\fmid-koppeling\firebase-sleutel.json
GOOGLE_APPLICATION_CREDENTIALS=/opt/fmid-koppeling/firebase-sleutel.json

# Optioneel: één klantnummer voor een proef (leeg = alle klanten met open regels)
# AX_KLANT=5013
