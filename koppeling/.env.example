# Kopieer dit bestand op de Pi naar .env en vul het wachtwoord in.
# Het wachtwoord hoort niet in git. Het staat in AantalAcs.py, achter PWD=.

AX_SQL_SERVER=192.168.5.34
AX_SQL_DATABASE=AXDB30SP4
AX_DATAAREAID=fmd
AX_SQL_GEBRUIKER=andelcontrol1
AX_SQL_WACHTWOORD=
# Alleen op Windows nodig; de Pi gebruikt FreeTDS.
# AX_SQL_DRIVER=SQL Server

# Controlsys, de gereedschapdatabase. Zelfde server en login als Axapta
# tenzij je hier een andere invult.
CS_SQL_DATABASE=Controlsys
# CS_SQL_SERVER=192.168.5.34
# CS_SQL_GEBRUIKER=andelcontrol1
# CS_SQL_WACHTWOORD=

# Pad op de Pi naar de Firebase-sleutel (niet in git).
GOOGLE_APPLICATION_CREDENTIALS=/home/pi/koppeling/firebase-sleutel.json
