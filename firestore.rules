rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile() && myProfile().role == 'admin';
    }

    // Alleen door een admin goedgekeurde gebruikers (rol invoer of admin) komen
    // bij de data. Iedereen kan via de Firebase Auth-API zelf een account
    // aanmaken, dus "ingelogd" alleen is niet genoeg.
    function isActive() {
      return hasProfile() && myProfile().role in ['invoer', 'admin'];
    }

    // Elke ingelogde gebruiker heeft een profiel met naam + rol
    // (wachtend | invoer | admin). Bij de eerste login maakt iemand zijn eigen
    // profiel aan, altijd als "wachtend"; een admin keurt goed door de rol te
    // wijzigen. Alleen een admin mag rollen wijzigen of andermans profiel aanpassen.
    match /users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isActive();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'wachtend';
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Stamgegevens en orders: alle goedgekeurde collega's mogen lezen/invoeren/wijzigen.
    // Verwijderen is voorbehouden aan admins, om te voorkomen dat iemand per ongeluk
    // een order of klant volledig weggooit.
    match /klanten/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    match /leveranciers/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    match /artikelen/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Locaties/magazijnen: iedereen die is ingelogd mag ze aanmaken en wijzigen
    // (net als artikelen) zodat je niet voor elk nieuw magazijn een admin nodig hebt.
    match /locaties/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Voorraadstand per artikel+locatie. Alleen via de app (transactie in
    // lib/voorraad.js) geschreven, maar de rule zelf staat gewoon elke
    // ingelogde gebruiker toe te schrijven, net als bij mutaties hieronder.
    match /voorraadstanden/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    match /verkooporders/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Verkooporderregels: zelfde patroon als inkooporderregels.
    match /verkooporderregels/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Pakbonnen en facturen worden vanuit een verkooporder gemaakt. Na het
    // aanmaken worden alleen nog de mailgegevens bijgewerkt; de inhoud van een
    // factuur (bedragen, regels, nummer) ligt vast.
    match /pakbonnen/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    match /facturen/{docId} {
      allow read: if isActive();
      allow create: if isActive();
      allow update: if isActive()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['gemaildNaar', 'gemaildCc', 'gemaildOp', 'mailId']);
      allow delete: if isAdmin();
    }

    match /inkooporders/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Inkooporderregels (artikel + aantal + prijs van een inkooporder).
    // Zelfde patroon als stuklijstregels/routeregels: platte collectie,
    // client-side gefilterd op inkooporderId.
    match /inkooporderregels/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    match /productieorders/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    match /voorraadmutaties/{docId} {
      allow read: if isActive();
      allow create: if isActive();
      allow update, delete: if isAdmin();
    }

    // Metadata van PDF's die aan een artikel gekoppeld zijn (het bestand zelf
    // staat in Storage, zie storage.rules). Zelfde patroon als mutaties: iedereen
    // mag toevoegen, alleen een admin mag verwijderen.
    match /artikeldocumenten/{docId} {
      allow read: if isActive();
      allow create: if isActive();
      allow update, delete: if isAdmin();
    }

    // Stuklijstregels (componenten + aantal van een artikel met artikeltype
    // "Stuklijst"). Stamgegevens, dus zelfde patroon als artikelen/locaties:
    // iedereen mag aanmaken/wijzigen, verwijderen is voorbehouden aan admins.
    match /stuklijstregels/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Routeregels (bewerkingen + bewerkingscentrum + tijd van een artikel met
    // artikeltype "Stuklijst"). Zelfde patroon als stuklijstregels hierboven.
    match /routeregels/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Uitgaande mail (o.a. inkooporders als PDF). De Cloud Function
    // verstuurMail verstuurt nieuwe documenten en schrijft de status terug in `delivery`
    // (via de Admin SDK, dus buiten deze rules om). Gebruikers mogen alleen
    // nieuwe mail klaarzetten en de status lezen, niet achteraf wijzigen.
    match /mail/{docId} {
      allow read: if isActive();
      allow create: if isActive() && !('delivery' in request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /counters/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }
  }
}
