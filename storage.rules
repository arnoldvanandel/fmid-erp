rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // PDF-documenten per artikel (zie ook artikeldocumenten in firestore.rules
    // voor de metadata). Iedereen die is ingelogd mag uploaden/lezen,
    // verwijderen is voorbehouden aan admins.
    match /artikelen/{artikelId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }
  }
}
